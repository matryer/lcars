# Ignore everything at the top level; allow project files explicitly.
/*
!/.gitignore
!/.github/
!/README.md
!/PLAN.md
!/LICENSE
!/go.mod
!/go.sum
!/mise.toml
!/package.json
!/package-lock.json
!/cmd/
!/internal/
!/web/
!/skills/
!/tools/
!/examples/
!/docs/

# Never commit secrets, local environment, or logs, even in allowed folders.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
*.log

# Build output inside allowed folders.
/cmd/lcars/lcars
node_modules/
